{
  "name": "@asmak-bilisim/bondi-coupon-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Pinned coupon distribution and same-wallet USDC redemption contracts for Bondi Finance",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ASMAK-Bilisim/bondi-coupon-contracts.git"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "clean": "hardhat clean && node scripts/clean-thirdweb-artifacts.cjs",
    "thirdweb:verify": "node scripts/compile-thirdweb.cjs --verify-only",
    "thirdweb:compile": "node scripts/compile-thirdweb.cjs",
    "compile": "npm run thirdweb:compile && hardhat compile",
    "test": "npm run compile && hardhat test --no-compile",
    "test:contracts": "hardhat test --no-compile",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "format:check": "prettier --check 'contracts/interfaces/ICouponToken.sol' 'contracts/mocks/*.sol' 'test/**/*.ts' 'scripts/**/*.{cjs,ts}' '*.{json,md,ts}' 'config/*.json' 'docs/**/*.md' 'provenance/*.json'",
    "typecheck": "tsc --noEmit",
    "verify:licenses": "node scripts/verify-licenses.cjs",
    "verify:release": "node scripts/verify-release-manifest.cjs",
    "verify:stack": "ts-node scripts/verify-locked-stack.ts",
    "check": "npm run verify:licenses && npm run thirdweb:verify && npm run typecheck && npm run compile && npm run verify:release && npm run lint:sol && npm run format:check && npm run test:contracts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "1.0.4",
    "@nomicfoundation/hardhat-network-helpers": "1.0.6",
    "@nomiclabs/hardhat-ethers": "2.2.3",
    "@openzeppelin/contracts": "4.9.6",
    "@openzeppelin/contracts-upgradeable": "4.9.6",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.18.6",
    "chai": "4.5.0",
    "ethers": "5.7.2",
    "hardhat": "2.25.0",
    "openzeppelin-contracts-upgradeable-4.9.0": "npm:@openzeppelin/contracts-upgradeable@4.9.0",
    "prettier": "2.8.8",
    "prettier-plugin-solidity": "1.2.0",
    "solady": "0.0.180",
    "solc": "0.8.23",
    "solc-0.8.9": "npm:solc@0.8.9",
    "solhint": "3.6.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.2"
  }
}
